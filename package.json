{
  "name": "deepsky",
  "version": "1.2.10",
  "description": "Your command center for GitHub Copilot CLI — manage, search, and switch between sessions from a sleek desktop app.",
  "main": "src/main.js",
  "author": "itsela-ms",
  "license": "MIT",
  "scripts": {
    "build": "esbuild src/renderer.js --bundle --outfile=dist/renderer.js --platform=browser --format=iife",
    "start": "npm run build && electron . --no-sandbox",
    "launch": "npm run build && wscript launch.vbs",
    "test": "vitest run",
    "benchmark:status": "node scripts/benchmark-status-service.js",
    "dist": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac --arm64"
  },
  "build": {
    "appId": "com.itsela.deepsky",
    "productName": "DeepSky",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "CHANGELOG.md",
      "src/**/*",
      "dist/**/*",
      "node_modules/**/*",
      "!node_modules/.cache"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "afterPack": "scripts/after-pack.js",
    "win": {
      "target": "nsis",
      "icon": "deepsky.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": "arm64"
        },
        {
          "target": "zip",
          "arch": "arm64"
        }
      ],
      "icon": "deepsky.png",
      "category": "public.app-category.developer-tools",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "writeUpdateInfo": false
    },
    "publish": {
      "provider": "github",
      "owner": "itsela-ms",
      "repo": "DeepSky"
    },
    "forceCodeSigning": false
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "electron-updater": "^6.7.3",
    "js-yaml": "^4.1.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.7.0",
    "esbuild": "^0.27.3",
    "jsdom": "^27.0.1",
    "vitest": "^4.0.18"
  }
}
